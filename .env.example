# Environment variables the app reads. Set them in the Render dashboard, your shell or
# docker-compose.yml (the app does not load .env files itself). No secrets are needed.

# Public base URL, used for canonical links, Open Graph tags, robots.txt and sitemap.xml.
SITE_URL=https://personal-portfolio-hub-3z4y.onrender.com

# Optional external resume link (for example a shared PDF). If unset, the site shows the
# resume button only when app/static/resume.pdf exists.
RESUME_URL=
